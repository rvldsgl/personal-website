---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit' });
}
---

<BaseLayout title="Writing" description="Everything Aldo has written.">

  <h1 style="margin-bottom: 2rem;">Writing</h1>

  <ul class="post-list">
    {posts.map(post => (
      <li>
        <span class="post-date">{formatDate(post.data.date)}</span>
        <a href={`/writing/${post.id}`}>{post.data.title}</a>
      </li>
    ))}
  </ul>

  {posts.length === 0 && (
    <p style="color: #999; font-style: italic;">Nothing yet.</p>
  )}

</BaseLayout>
