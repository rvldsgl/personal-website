---
import '../styles/global.css';
import { Analytics } from '@vercel/analytics/astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Aldo's personal site.",
} = Astro.props;

const fullTitle = title === 'Aldo' ? 'Aldo' : `${title} — Aldo`;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <link rel="alternate" type="application/rss+xml" title="Aldo" href="/rss.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
  </head>

  <body>
    <header>
      <a href="/" class="site-title">Aldo</a>
      <nav>
        <a href="/writing" class={currentPath.startsWith('/writing') ? 'active' : ''}>Writing</a>
        <a href="/about" class={currentPath === '/about' ? 'active' : ''}>About</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <span>&copy; {new Date().getFullYear()} Aldo</span>
      <div class="footer-links">
        <a href="https://github.com/rvldsgl" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="https://www.linkedin.com/in/revaldosagala/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="mailto:aldogksagala@gmail.com">Email</a>
        <a href="/rss.xml">RSS</a>
      </div>
    </footer>
    <Analytics />
  </body>
</html>
